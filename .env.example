# --- Required ---
# SQLite for local dev. For production swap prisma/schema.prisma provider to "postgresql"
# and point this at a Postgres URL (Neon, Supabase, Vercel Postgres all work).
DATABASE_URL="file:../data/app.db"

# Anthropic API key. Without it the app runs in demo mode: uploads return a sample plan.
ANTHROPIC_API_KEY=

# Password for /admin where you create builder accounts.
ADMIN_PASSWORD=change-me

# Public base URL, used for share links and Stripe redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional ---
# Product name shown on the marketing site and default branding.
NEXT_PUBLIC_PRODUCT_NAME=PlanWalk

# Vercel Blob for uploads in production. Local disk (./data/uploads) is used when unset.
BLOB_READ_WRITE_TOKEN=

# Stripe for selling model credits to builders. Billing UI is hidden when unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREDITS_10=
STRIPE_PRICE_CREDITS_50=
