// Swap provider to "postgresql" for production. Nothing else in the schema changes.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Builder {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  tagline       String?
  logoUrl       String?
  primaryColor  String    @default("#1d4ed8")
  accentColor   String    @default("#f59e0b")
  website       String?
  phone         String?
  email         String?
  welcomeText   String?
  adminKey      String    @unique
  credits       Int       @default(5)
  stripeCustomerId String?
  createdAt     DateTime  @default(now())
  projects      Project[]
}

model Project {
  id          String   @id @default(cuid())
  shareId     String   @unique
  builderId   String
  builder     Builder  @relation(fields: [builderId], references: [id], onDelete: Cascade)
  name        String
  mode        String   // "blueprint" | "photos" | "text"
  status      String   @default("draft") // draft | extracting | ready | failed
  prompt      String?
  clientName  String?
  clientEmail String?
  plan        String?  // FloorPlan JSON
  error       String?
  images      ProjectImage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  width     Int?
  height    Int?
  kind      String  @default("source") // source | photo
  order     Int     @default(0)
}

model CreditPurchase {
  id          String   @id @default(cuid())
  builderId   String
  credits     Int
  amountCents Int
  stripeSessionId String @unique
  createdAt   DateTime @default(now())
}
